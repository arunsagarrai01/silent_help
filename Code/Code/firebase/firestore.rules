rules_version = '2';

// SilentHelp Firestore Security Rules
//
// Principles:
//  - All access requires an authenticated user.
//  - Users can only read/write their own data (ownership by uid).
//  - Roles come from custom claims (server-controlled); clients can NEVER
//    write a `role` field or escalate privileges.
//  - Document structure + allowed fields are validated on write.
//  - Deletes are restricted.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function role() {
      return request.auth.token.role;
    }
    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }
    // True if the incoming data does NOT try to set a protected field.
    function noRoleField(data) {
      return !('role' in data.keys());
    }

    // ---- users/{uid} ----
    // A user owns exactly their own profile doc. `role` is never client-writable.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && noRoleField(request.resource.data)
                    && request.resource.data.keys().hasOnly(
                         ['displayName', 'updatedAt', 'createdAt']);
      allow update: if isOwner(uid)
                    && noRoleField(request.resource.data)
                    && request.resource.data.keys().hasOnly(
                         ['displayName', 'updatedAt']);
      allow delete: if isAdmin();
    }

    // ---- trustedContacts/{contactId} ----
    // Each contact doc must carry ownerUid == the caller.
    match /trustedContacts/{contactId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['ownerUid', 'name', 'phoneHash', 'updatedAt']);
      allow update: if isSignedIn()
                    && resource.data.ownerUid == request.auth.uid
                    && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- emergencyEvents/{eventId} ----
    // Owner can create + read their own events. Events are immutable once
    // written (no client update), and only admins may delete.
    match /emergencyEvents/{eventId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['id', 'ownerUid', 'triggerType', 'timestamp',
                          'lat', 'lng', 'contactCount', 'deliveredCount',
                          'status', 'source'])
                    && request.resource.data.id == eventId;
      allow update: if false; // immutable from client
      allow delete: if isAdmin();
    }

    // ---- devices/{deviceId} ----
    match /devices/{deviceId} {
      allow read, write: if isSignedIn()
                         && request.resource.data.ownerUid == request.auth.uid;
    }

    // ---- notificationTokens/{tokenId} ----
    match /notificationTokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update: if isSignedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['ownerUid', 'token', 'platform', 'updatedAt']);
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---- appSettings/{document} ----
    // Global read-only config for signed-in users; only admins may write.
    match /appSettings/{document} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- auditLogs/{logId} ----
    // Written only by Cloud Functions (Admin SDK bypasses rules). Clients:
    // admins may read; nobody may write directly.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
